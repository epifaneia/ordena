# Copia este archivo a .env y rellena. El .env no se sube al repo.

# --- Business Central online (la prueba gratuita de 30 días en un tenant de Microsoft 365) ---
# Directory (tenant) ID de Entra y nombre del entorno (la prueba crea "Production").
BC_TENANT_ID=
BC_ENVIRONMENT=Production
# Nombre de la empresa dentro del entorno. Vacío = la primera (CRONUS).
BC_COMPANY=
# Application (client) ID de la aplicación registrada en Entra.
BC_CLIENT_ID=
# Solo para el modo aplicación (client credentials, el "usuario de servicio").
# Vacío = inicio de sesión de usuario por código de dispositivo.
BC_CLIENT_SECRET=

# --- Interpretación ---
# ollama (local, por defecto) | gemini | groq (nube: solo techo de comparación con los datos de CRONUS)
ORDENA_LLM_BACKEND=ollama
ORDENA_LLM_URL=http://localhost:11434
# 6 GB de GPU: clase 7B. Con más memoria, qwen2.5:14b o mayor.
ORDENA_LLM_MODELO=qwen2.5:7b
ORDENA_GEMINI_MODELO=gemini-2.5-flash
ORDENA_GROQ_MODELO=openai/gpt-oss-120b
# Claves de nube: solo si se pide comparar con la nube.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Transcripción ---
# local (faster-whisper, por defecto) | groq (Whisper en la nube, techo)
ORDENA_STT_BACKEND=local
ORDENA_GROQ_STT_MODELO=whisper-large-v3
ORDENA_WHISPER_MODELO=large-v3-turbo
# cuda o cpu. Si cuda falla por librerías, la prueba de concepto cae a cpu sola.
ORDENA_WHISPER_DEVICE=cuda
# cuda: int8_float16 o float16. cpu: int8.
ORDENA_WHISPER_COMPUTE=int8_float16

# --- Esquema de pedido: campos sin los cuales un ticket nace incompleto ---
ORDENA_CAMPOS_OBLIGATORIOS=cliente,lineas,cantidad,fecha_entrega
